{
  "name": "electron",
  "private": true,
  "version": "0.1.0",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node ../scripts/prepare-electron-dev.mjs && tsc -p tsconfig.json && ELECTRON_RENDERER_URL=http://127.0.0.1:5174 CAMBORDER_ENGINE_PORT=8099 electron dist/main/main.js",
    "dev:managed": "node ../scripts/prepare-electron-dev.mjs && tsc -p tsconfig.json && electron dist/main/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "electron-builder": "^25.1.8",
    "vitest": "^2.1.9",
    "electron": "^31.0.0"
  }
}
